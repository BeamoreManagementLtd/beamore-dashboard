# Copy to .env.local for local development, and add the same names in Vercel → Settings → Environment Variables.
# Never commit real values or paste them into chat.

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server-only: sync jobs and the one-off import

# Site address used for sign-in redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Xero app (developer.xero.com)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TENANT_ID=

# Google service access for Drive/Sheets/Gmail sync
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Protects the scheduled sync endpoints (any long random string)
CRON_SECRET=
